# Copy this file to ".env" and fill in your real Supabase project values.
# Find these in your Supabase project: Settings -> API.
# Never commit the real ".env" file - it's already excluded in .gitignore.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# The business WhatsApp number, digits only, no "+" or spaces.
# (Also stored in the database "settings" table once Supabase is connected,
# so the site keeps working even if this env var is ever missing.)
VITE_WHATSAPP_NUMBER=14372676919
